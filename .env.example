# Copy to .env.local for local development. On Vercel, set the same names under
# Project → Settings → Environment Variables. Never prefix any of these with NEXT_PUBLIC_.

# Required: Vercel Blob read-write token, for local development only. On Vercel, connecting a Blob
# store to the project provides BLOB_STORE_ID and authenticates with OIDC, so nothing is needed there.
# Create a private store (Storage → Blob, or `vercel blob create-store <name> --access private`),
# then copy its token, or run `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=

# Required: studio sign-in. Generate the secret with: openssl rand -base64 48
PORTFOLIO_ADMIN_EMAIL=
PORTFOLIO_ADMIN_PASSWORD=
PORTFOLIO_SESSION_SECRET=

# Optional: YouTube Data API key. Lets the player find an embeddable version of a blocked song.
PORTFOLIO_YOUTUBE_API_KEY=

# Optional: RAWG API key (free at https://rawg.io/apidocs). Enables game search in the studio's Games tab.
PORTFOLIO_RAWG_API_KEY=
